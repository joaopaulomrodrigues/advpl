#include "tlpp-core.th"
namespace custom.integration.soc

class SocResult
    static method ok(cMsg as character, cId as character, oRaw as object) as object
    static method fail(cMsg as character, nHttp as numeric, cRaw as character) as object
endclass

static method SocResult::ok(cMsg as character, cId as character, oRaw as object) as object
    local oRet := JsonObject():New()
    oRet['success'] := .T.
    oRet['message'] := cMsg
    oRet['id']      := cId
    oRet['http']    := 200
    oRet['data']    := oRaw
return oRet

static method SocResult::fail(cMsg as character, nHttp as numeric, cRaw as character) as object
    local oRet := JsonObject():New()
    oRet['success'] := .F.
    oRet['message'] := cMsg
    oRet['id']      := ""
    oRet['http']    := nHttp
    oRet['raw']     := cRaw
return oRet
