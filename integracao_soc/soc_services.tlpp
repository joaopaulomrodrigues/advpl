/*/{Protheus.doc} SocSetor
Serviço de integração de Centro de Custo/Setor (SI3). Chave: I3_FILIAL+I3_CUSTO.
@type class
@author Integracao SOC
@since 13/11/2026
@version 1.0
@obs Em releases atuais o centro de custo pode estar na CTT; ajustar se necessário.
@example
oRet := SocSetor():new():incluir(xFilial("SI3") + "100")
/*/
class SocSetor from SocServiceBase
    public method new() as object
    protected method seekRecord(cChave as character) as logical
    protected method buildPayload() as object
    protected method required() as array
endclass

/*/{Protheus.doc} SocSetor::new
Construtor (alias SI3, recurso setor).
@type method
@author Integracao SOC
@since 13/11/2026
@return object, Instância
/*/
method new() as object class SocSetor
    _Super:new("SI3", "setor")
return self

/*/{Protheus.doc} SocSetor::seekRecord
Posiciona a SI3 (índice 1).
@type method
@author Integracao SOC
@since 13/11/2026
@param cChave, character, I3_FILIAL+I3_CUSTO
@return logical, .T. se encontrou
/*/
method seekRecord(cChave as character) as logical class SocSetor
    DbSelectArea("SI3"); SI3->(DbSetOrder(1))
return SI3->(DbSeek(cChave))

/*/{Protheus.doc} SocSetor::buildPayload
Monta o JSON do setor (código, nome, unidade).
@type method
@author Integracao SOC
@since 13/11/2026
@return object, JsonObject do payload
/*/
method buildPayload() as object class SocSetor
    local o := JsonObject():New()
    o['codigo']        := SocMapper():toSoc("CC", SI3->I3_CUSTO, "")
    o['nome']          := AllTrim(SI3->I3_DESC)
    o['codigoUnidade'] := SocMapper():toSoc("FIL", SI3->I3_FILIAL, "")
return o

/*/{Protheus.doc} SocSetor::required
Campos obrigatórios do payload.
@type method
@author Integracao SOC
@since 13/11/2026
@return array, Propriedades obrigatórias
/*/
method required() as array class SocSetor
return {"codigo","nome"}

/*/{Protheus.doc} SocFilial
Serviço de integração de Filiais/Unidades (SM0). Chave: M0_CODFIL.
@type class
@author Integracao SOC
@since 13/11/2026
@version 1.0
@obs SM0 não é tabela do dicionário; validar o posicionamento na release em uso.
@example
oRet := SocFilial():new():incluir("01")
/*/
class SocFilial from SocServiceBase
    public method new() as object
    protected method seekRecord(cChave as character) as logical
    protected method buildPayload() as object
    protected method required() as array
endclass

/*/{Protheus.doc} SocFilial::new
Construtor (alias SM0, recurso unidade).
@type method
@author Integracao SOC
@since 13/11/2026
@return object, Instância
/*/
method new() as object class SocFilial
    _Super:new("SM0", "unidade")
return self

/*/{Protheus.doc} SocFilial::seekRecord
Verifica a existência da filial via FWArrFilAtu.
@type method
@author Integracao SOC
@since 13/11/2026
@param cChave, character, Código da filial (M0_CODFIL)
@return logical, .T. se encontrou
/*/
method seekRecord(cChave as character) as logical class SocFilial
    local aFil := FWArrFilAtu(cEmpAnt, AllTrim(cChave))
return Len(aFil) > 0

/*/{Protheus.doc} SocFilial::buildPayload
Monta o JSON da unidade (código, nome, CNPJ, endereço).
@type method
@author Integracao SOC
@since 13/11/2026
@return object, JsonObject do payload
/*/
method buildPayload() as object class SocFilial
    local o := JsonObject():New()
    o['codigo']   := SocMapper():toSoc("FIL", AllTrim(SM0->M0_CODFIL), "")
    o['nome']     := AllTrim(SM0->M0_FILIAL)
    o['cnpj']     := SocMapper():onlyNum(SM0->M0_CGC)
    o['endereco'] := AllTrim(SM0->M0_ENDCOB)
    o['cidade']   := AllTrim(SM0->M0_CIDCOB)
    o['uf']       := AllTrim(SM0->M0_ESTCOB)
    o['cep']      := SocMapper():onlyNum(SM0->M0_CEPCOB)
return o

/*/{Protheus.doc} SocFilial::required
Campos obrigatórios do payload.
@type method
@author Integracao SOC
@since 13/11/2026
@return array, Propriedades obrigatórias
/*/
method required() as array class SocFilial
return {"codigo","nome","cnpj"}

/*/{Protheus.doc} SocDesligamento
Serviço de integração de Rescisão/Afastamento (SRG/SRA). Chave: RG_FILIAL+RG_MAT.
@type class
@author Integracao SOC
@since 13/11/2026
@version 1.0
@example
oRet := SocDesligamento():new():incluir(xFilial("SRG") + "000123")
/*/
class SocDesligamento from SocServiceBase
    public method new() as object
    protected method seekRecord(cChave as character) as logical
    protected method buildPayload() as object
    protected method required() as array
endclass

/*/{Protheus.doc} SocDesligamento::new
Construtor (alias SRG, recurso afastamento).
@type method
@author Integracao SOC
@since 13/11/2026
@return object, Instância
/*/
method new() as object class SocDesligamento
    _Super:new("SRG", "afastamento")
return self

/*/{Protheus.doc} SocDesligamento::seekRecord
Posiciona SRG e SRA (índice 1).
@type method
@author Integracao SOC
@since 13/11/2026
@param cChave, character, RG_FILIAL+RG_MAT
@return logical, .T. se ambas foram encontradas
/*/
method seekRecord(cChave as character) as logical class SocDesligamento
    DbSelectArea("SRG"); SRG->(DbSetOrder(1))
    DbSelectArea("SRA"); SRA->(DbSetOrder(1))
return SRG->(DbSeek(cChave)) .and. SRA->(DbSeek(cChave))

/*/{Protheus.doc} SocDesligamento::buildPayload
Monta o JSON do desligamento (matrícula, CPF, data, motivo).
@type method
@author Integracao SOC
@since 13/11/2026
@return object, JsonObject do payload
/*/
method buildPayload() as object class SocDesligamento
    local o := JsonObject():New()
    o['matricula']        := AllTrim(SRG->RG_MAT)
    o['cpf']              := SocMapper():onlyNum(SRA->RA_CIC)
    o['tipo']             := "DESLIGAMENTO"
    o['dataDesligamento'] := SocMapper():fmtDate(DtoS(SRG->RG_DATADEM))
    o['motivo']           := SocMapper():toSoc("MOTRES", SRG->RG_TIPORES, "")
return o

/*/{Protheus.doc} SocDesligamento::required
Campos obrigatórios do payload.
@type method
@author Integracao SOC
@since 13/11/2026
@return array, Propriedades obrigatórias
/*/
method required() as array class SocDesligamento
return {"matricula","dataDesligamento"}
