#include "tlpp-core.th"
namespace custom.integration.soc

// ---------- FUNCIONARIO (SRA) ----------
class SocFuncionario from SocServiceBase
    public method new() as object
    protected method seekRecord(cChave as character) as logical
    protected method buildPayload() as object
    protected method required() as array
endclass

method SocFuncionario::new() as object
    _Super:new("SRA", "funcionario")
return self

method SocFuncionario::seekRecord(cChave as character) as logical
    DbSelectArea("SRA"); SRA->(DbSetOrder(1))
return SRA->(DbSeek(cChave))

method SocFuncionario::buildPayload() as object
    local o := JsonObject():New()
    o['codigoEmpresa']  := SocMapper():toSoc("FIL", SRA->RA_FILIAL, "")
    o['matricula']      := AllTrim(SRA->RA_MAT)
    o['nome']           := AllTrim(SRA->RA_NOME)
    o['cpf']            := SocMapper():onlyNum(SRA->RA_CIC)
    o['pis']            := SocMapper():onlyNum(SRA->RA_PIS)
    o['rg']             := AllTrim(SRA->RA_RG)
    o['dataNascimento'] := SocMapper():fmtDate(DtoS(SRA->RA_NASC))
    o['sexo']           := SocMapper():sexo(SRA->RA_SEXO)
    o['dataAdmissao']   := SocMapper():fmtDate(DtoS(SRA->RA_ADMISSA))
    o['email']          := AllTrim(SRA->RA_EMAIL)
    o['codigoCargo']    := SocMapper():toSoc("CARGO", SRA->RA_CODFUNC, "")
    o['codigoSetor']    := SocMapper():toSoc("CC"   , SRA->RA_CC     , "")
    o['codigoTurno']    := SocMapper():toSoc("TURNO", SRA->RA_TNOTRAB, "")
    o['situacao']       := SocMapper():toSoc("SITUACAO", iif(Empty(SRA->RA_SITFOLH),"A",SRA->RA_SITFOLH), "ATIVO")
return o

method SocFuncionario::required() as array
return {"matricula","nome","cpf","dataAdmissao","codigoCargo","codigoSetor"}

// ---------- CARGO (SRJ) ----------
class SocCargo from SocServiceBase
    public method new() as object
    protected method seekRecord(cChave as character) as logical
    protected method buildPayload() as object
    protected method required() as array
endclass
method SocCargo::new() as object
    _Super:new("SRJ", "cargo")
return self
method SocCargo::seekRecord(cChave as character) as logical
    DbSelectArea("SRJ"); SRJ->(DbSetOrder(1))
return SRJ->(DbSeek(cChave))
method SocCargo::buildPayload() as object
    local o := JsonObject():New()
    o['codigo'] := SocMapper():toSoc("CARGO", SRJ->RJ_FUNCAO, "")
    o['nome']   := AllTrim(SRJ->RJ_DESC)
    o['cbo']    := AllTrim(SRJ->RJ_CODCBO)
return o
method SocCargo::required() as array
return {"codigo","nome"}

