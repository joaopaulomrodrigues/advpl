#include "tlpp-core.th"
namespace custom.integration.soc

/*/{Protheus.doc} SocFuncionario
Serviço de integração de Funcionários (SRA). Chave: RA_FILIAL+RA_MAT.
@type class
@author Integracao SOC
@since 13/11/2026
@version 1.0
@example
oRet := SocFuncionario():new():incluir(xFilial("SRA") + "000123")
/*/
class SocFuncionario from SocServiceBase
    public method new() as object
    protected method seekRecord(cChave as character) as logical
    protected method buildPayload() as object
    protected method required() as array
endclass

/*/{Protheus.doc} SocFuncionario::new
Construtor (alias SRA, recurso funcionario).
@type method
@author Integracao SOC
@since 13/11/2026
@return object, Instância
/*/
method new() as object class SocFuncionario
    _Super:new("SRA", "funcionario")
return self

/*/{Protheus.doc} SocFuncionario::seekRecord
Posiciona a SRA (índice 1).
@type method
@author Integracao SOC
@since 13/11/2026
@param cChave, character, RA_FILIAL+RA_MAT
@return logical, .T. se encontrou
/*/
method seekRecord(cChave as character) as logical class SocFuncionario
    DbSelectArea("SRA"); SRA->(DbSetOrder(1))
return SRA->(DbSeek(cChave))

/*/{Protheus.doc} SocFuncionario::buildPayload
Monta o JSON do funcionário aplicando De/Para de filial, cargo, setor, turno e situação.
@type method
@author Integracao SOC
@since 13/11/2026
@return object, JsonObject do payload
/*/
method buildPayload() as object class SocFuncionario
    local o := JsonObject():New()
    o['codigoEmpresa']  := SocMapper():toSoc("FIL", SRA->RA_FILIAL, "")
    o['matricula']      := AllTrim(SRA->RA_MAT)
    o['nome']           := AllTrim(SRA->RA_NOME)
    o['cpf']            := SocMapper():onlyNum(SRA->RA_CIC)
    o['pis']            := SocMapper():onlyNum(SRA->RA_PIS)
    o['rg']             := AllTrim(SRA->RA_RG)
    o['dataNascimento'] := SocMapper():fmtDate(DtoS(SRA->RA_NASC))
    o['sexo']           := SocMapper():sexo(SRA->RA_SEXO)
    o['dataAdmissao']   := SocMapper():fmtDate(DtoS(SRA->RA_ADMISSA))
    o['email']          := AllTrim(SRA->RA_EMAIL)
    o['codigoCargo']    := SocMapper():toSoc("CARGO", SRA->RA_CODFUNC, "")
    o['codigoSetor']    := SocMapper():toSoc("CC"   , SRA->RA_CC     , "")
    o['codigoTurno']    := SocMapper():toSoc("TURNO", SRA->RA_TNOTRAB, "")
    o['situacao']       := SocMapper():toSoc("SITUACAO", iif(Empty(SRA->RA_SITFOLH),"A",SRA->RA_SITFOLH), "ATIVO")
return o

/*/{Protheus.doc} SocFuncionario::required
Campos obrigatórios do payload.
@type method
@author Integracao SOC
@since 13/11/2026
@return array, Propriedades obrigatórias
/*/
method required() as array class SocFuncionario
return {"matricula","nome","cpf","dataAdmissao","codigoCargo","codigoSetor"}

